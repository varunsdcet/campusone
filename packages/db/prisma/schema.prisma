generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  legalName     String
  timezone      String   @default("America/Vancouver")
  currency      String   @default("CAD")
  addressLine1  String
  city          String
  region        String
  postalCode    String
  country       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
}

model Person {
  id                    String    @id @default(uuid())
  institutionId         String
  givenName             String
  familyName            String
  middleName            String?
  preferredName         String?
  email                 String
  personalEmail         String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  dateOfBirth           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  rowVersion            Int       @default(1)
  accounts              Account[]
  students              Student[]

  @@unique([institutionId, email])
  @@index([institutionId])
}

model Account {
  id                    String                        @id @default(uuid())
  institutionId         String
  personId              String
  email                 String
  passwordHash          String
  status                String                        @default("active")
  mfaEnabled            Boolean                       @default(false)
  timezone              String                        @default("America/Vancouver")
  rolesJson             String                        @default("[]")
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  rowVersion            Int                           @default(1)
  person                Person                        @relation(fields: [personId], references: [id])
  sessions              Session[]
  notifications         Notification[]
  aiInteractions        AiInteraction[]
  mailFolders           MailFolder[]
  mailboxSettings       MailboxSettings?
  mailPlacements        MailThreadPlacement[]
  mailDistributionLists MailDistributionList[]
  accessLevelAssignment AccountAccessLevelAssignment?
  aiPlannerRuns         AiPlannerRun[]

  @@unique([institutionId, email])
  @@index([institutionId])
}

model Session {
  id                String   @id @default(uuid())
  institutionId     String
  accountId         String
  deviceFingerprint String
  ipAddress         String
  userAgent         String
  geoLocation       String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  rowVersion        Int      @default(1)
  account           Account  @relation(fields: [accountId], references: [id])

  @@index([institutionId])
  @@index([accountId])
}

model SecurityPolicy {
  id                         String   @id @default(uuid())
  institutionId              String   @unique
  maxConcurrentSessions      Int      @default(3)
  sharedIpAlertWindowMinutes Int      @default(5)
  adminIpAllowlistCidrsJson  String   @default("[]")
  passwordMinLength          Int      @default(10)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  rowVersion                 Int      @default(1)
}

model Student {
  id                     String                          @id @default(uuid())
  institutionId          String
  personId               String
  studentNumber          String
  programName            String
  programVersionId       String?
  cohortId               String?
  standing               String                          @default("good")
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  rowVersion             Int                             @default(1)
  person                 Person                          @relation(fields: [personId], references: [id])
  programVersion         ProgramVersion?                 @relation(fields: [programVersionId], references: [id])
  cohort                 Cohort?                         @relation(fields: [cohortId], references: [id])
  enrolments             Enrolment[]
  gradeItems             GradeItem[]
  submissions            Submission[]
  degreeScenarios        DegreePlanScenario[]
  advisingAppointments   AdvisingAppointment[]
  successCases           SuccessCase[]
  transferCredits        TransferCredit[]
  assessmentAttempts     AssessmentAttempt[]
  attendanceRecords      AttendanceRecord[]
  labNotebookEntries     LabNotebookEntry[]
  serviceRequests        ServiceRequest[]
  financeLedgerEntries   FinanceLedgerEntry[]
  credentialRecords      CredentialRecord[]
  placements             Placement[]
  programPlans           ProgramPlan[]
  courseEvaluations      CourseEvaluation[]
  workshopRegistrations  WorkshopRegistration[]
  workshopAttendance     WorkshopAttendance[]
  leaveOfAbsenceRequests LeaveOfAbsenceRequest[]
  requiredTasks          RequiredTask[]
  taxDocuments           TaxDocument[]
  extracurricularRecords ExtracurricularRecord[]
  badges                 StudentBadge[]
  documents              StudentDocument[]
  lifecycleStatus        StudentLifecycleStatus?
  lifecycleHistory       StudentLifecycleStatusHistory[]
  studyPlans             StudyPlan[]
  studySessions          StudySession[]
  focusSessions          FocusSession[]
  aiPlannerRuns          AiPlannerRun[]
  studyGoals             StudyGoal[]
  studyArtifacts         StudyArtifact[]
  opportunityBookmarks   OpportunityBookmark[]
  calendarConnections    CalendarConnection[]

  @@unique([institutionId, studentNumber])
  @@index([institutionId])
  @@index([programVersionId])
  @@index([cohortId])
}

/// Normalized student lifecycle catalogue and assignment. Legacy metadata is
/// retained during rollout, but authorization and reporting can now join by FK.
model StudentStatusDefinition {
  id            String                          @id @default(uuid())
  institutionId String
  key           String
  name          String
  parentKey     String?
  flagsJson     String                          @default("{}")
  active        Boolean                         @default(true)
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt
  assignments   StudentLifecycleStatus[]
  history       StudentLifecycleStatusHistory[]

  @@unique([institutionId, key])
  @@unique([id, institutionId])
}

model StudentLifecycleStatus {
  id                 String                  @id @default(uuid())
  institutionId      String
  studentId          String                  @unique
  statusDefinitionId String
  assignedAt         DateTime                @default(now())
  assignedById       String?
  student            Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  statusDefinition   StudentStatusDefinition @relation(fields: [statusDefinitionId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([institutionId, studentId])
  @@index([institutionId, statusDefinitionId])
}

model StudentLifecycleStatusHistory {
  id                 String                  @id @default(uuid())
  institutionId      String
  studentId          String
  statusDefinitionId String
  changedAt          DateTime                @default(now())
  changedById        String?
  student            Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  statusDefinition   StudentStatusDefinition @relation(fields: [statusDefinitionId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@index([institutionId, studentId, changedAt])
}

model AccessLevelDefinition {
  id                    String                         @id @default(uuid())
  institutionId         String
  key                   String
  name                  String
  profileType           String
  assignableByNonAdmins Boolean                        @default(false)
  permissionsJson       String                         @default("{}")
  active                Boolean                        @default(true)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  assignments           AccountAccessLevelAssignment[]
  history               AccountAccessLevelHistory[]

  @@unique([institutionId, key])
  @@unique([id, institutionId])
}

model AccountAccessLevelAssignment {
  id            String                @id @default(uuid())
  institutionId String
  accountId     String                @unique
  accessLevelId String
  assignedAt    DateTime              @default(now())
  assignedById  String?
  account       Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessLevel   AccessLevelDefinition @relation(fields: [accessLevelId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([institutionId, accountId])
  @@index([institutionId, accessLevelId])
}

model AccountAccessLevelHistory {
  id            String                @id @default(uuid())
  institutionId String
  accountId     String
  accessLevelId String
  changedAt     DateTime              @default(now())
  changedById   String?
  accessLevel   AccessLevelDefinition @relation(fields: [accessLevelId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@index([institutionId, accountId, changedAt])
}

model Program {
  id            String           @id @default(uuid())
  institutionId String
  code          String
  name          String
  awardLevel    String           @default("diploma")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  rowVersion    Int              @default(1)
  versions      ProgramVersion[]
  cohorts       Cohort[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

/// Intake group: Programme + month/year + section (e.g. CS Fall 2024 · A).
model Cohort {
  id            String        @id @default(uuid())
  institutionId String
  programId     String
  code          String
  label         String
  intakeYear    Int
  intakeMonth   Int
  sectionLabel  String        @default("A")
  campus        String?
  startDate     String?
  endDate       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  rowVersion    Int           @default(1)
  program       Program       @relation(fields: [programId], references: [id])
  students      Student[]
  programPlans  ProgramPlan[]

  @@unique([institutionId, code])
  @@index([institutionId, programId])
}

/// Ordered programme timetable / progress for one student in a cohort.
model ProgramPlan {
  id            String            @id @default(uuid())
  institutionId String
  studentId     String
  cohortId      String?
  status        String            @default("active")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  rowVersion    Int               @default(1)
  student       Student           @relation(fields: [studentId], references: [id])
  cohort        Cohort?           @relation(fields: [cohortId], references: [id])
  items         ProgramPlanItem[]

  @@index([institutionId, studentId])
  @@index([institutionId, studentId, status])
  @@index([cohortId])
}

model ProgramPlanItem {
  id            String      @id @default(uuid())
  institutionId String
  planId        String
  courseId      String?
  courseCode    String
  title         String
  credits       Float       @default(0)
  sortOrder     Int         @default(0)
  /// main | practicum | makeup
  category      String      @default("main")
  /// completed | in_progress | not_started | dropped
  status        String      @default("not_started")
  startsOn      String?
  endsOn        String?
  scheduleText  String?
  sectionId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rowVersion    Int         @default(1)
  plan          ProgramPlan @relation(fields: [planId], references: [id])
  course        Course?     @relation(fields: [courseId], references: [id])

  @@index([institutionId, planId, sortOrder])
  @@index([courseId])
}

model CourseEvaluation {
  id            String    @id @default(uuid())
  institutionId String
  studentId     String
  sectionId     String?
  courseCode    String
  courseTitle   String
  status        String    @default("pending")
  dueAt         DateTime?
  submittedAt   DateTime?
  overallRating Int?
  responsesJson String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)
  student       Student   @relation(fields: [studentId], references: [id])

  @@index([institutionId, studentId, status])
}

model ProgramVersion {
  id            String              @id @default(uuid())
  institutionId String
  programId     String
  label         String
  effectiveOn   String
  totalCredits  Float
  status        String              @default("active")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  rowVersion    Int                 @default(1)
  program       Program             @relation(fields: [programId], references: [id])
  requirements  DegreeRequirement[]
  students      Student[]

  @@unique([institutionId, programId, label])
  @@index([institutionId])
}

model DegreeRequirement {
  id               String         @id @default(uuid())
  institutionId    String
  programVersionId String
  courseId         String?
  courseCode       String
  title            String
  credits          Float
  kind             String         @default("required")
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  rowVersion       Int            @default(1)
  programVersion   ProgramVersion @relation(fields: [programVersionId], references: [id])
  course           Course?        @relation(fields: [courseId], references: [id])

  @@index([institutionId, programVersionId])
  @@index([institutionId, courseCode])
}

model CoursePrerequisite {
  id                   String   @id @default(uuid())
  institutionId        String
  courseId             String
  prerequisiteCourseId String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  rowVersion           Int      @default(1)
  course               Course   @relation("CourseHasPrereqs", fields: [courseId], references: [id])
  prerequisiteCourse   Course   @relation("CourseIsPrereq", fields: [prerequisiteCourseId], references: [id])

  @@unique([institutionId, courseId, prerequisiteCourseId])
  @@index([institutionId])
}

model DegreePlanScenario {
  id              String    @id @default(uuid())
  institutionId   String
  studentId       String
  label           String
  assumptionsJson String
  resultJson      String
  status          String    @default("draft")
  reviewNote      String?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  rowVersion      Int       @default(1)
  student         Student   @relation(fields: [studentId], references: [id])

  @@index([institutionId, studentId, createdAt])
  @@index([institutionId, status, createdAt])
}

model KnowledgeDocument {
  id            String   @id @default(uuid())
  institutionId String
  slug          String
  title         String
  docType       String
  body          String
  uri           String
  versionLabel  String   @default("1")
  status        String   @default("published")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)

  @@unique([institutionId, slug])
  @@index([institutionId, docType])
}

model Term {
  id            String    @id @default(uuid())
  institutionId String
  code          String
  name          String
  startsOn      String
  endsOn        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)
  sections      Section[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Course {
  id               String               @id @default(uuid())
  institutionId    String
  code             String
  title            String
  credits          Float
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  rowVersion       Int                  @default(1)
  sections         Section[]
  requirements     DegreeRequirement[]
  prereqFor        CoursePrerequisite[] @relation("CourseHasPrereqs")
  isPrereqOf       CoursePrerequisite[] @relation("CourseIsPrereq")
  coreqFor         CourseCorequisite[]  @relation("CourseHasCoreqs")
  isCoreqOf        CourseCorequisite[]  @relation("CourseIsCoreq")
  offerings        CourseOffering[]
  transferCredits  TransferCredit[]
  programPlanItems ProgramPlanItem[]
  courseResources  CourseResource[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Section {
  id                 String             @id @default(uuid())
  institutionId      String
  courseId           String
  termId             String
  academicBlockId    String?
  code               String
  instructorPersonId String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  rowVersion         Int                @default(1)
  course             Course             @relation(fields: [courseId], references: [id])
  term               Term               @relation(fields: [termId], references: [id])
  academicBlock      AcademicBlock?     @relation(fields: [academicBlockId], references: [id])
  enrolments         Enrolment[]
  assignments        Assignment[]
  classSessions      ClassSession[]
  assessments        Assessment[]
  attendanceRecords  AttendanceRecord[]
  dayBlocks          CourseDayBlock[]
  folders            CourseFolder[]
  syllabusTopics     SyllabusTopic[]
  studySessions      StudySession[]
  studyArtifacts     StudyArtifact[]

  @@unique([institutionId, termId, code])
  @@index([institutionId])
  @@index([academicBlockId])
}

model Enrolment {
  id                  String      @id @default(uuid())
  institutionId       String
  sectionId           String
  studentId           String
  /// enrolled | waitlisted | completed | withdrawn
  status              String      @default("enrolled")
  attemptNumber       Int         @default(1)
  countsTowardCgpa    Boolean     @default(true)
  creditAwarded       Boolean     @default(false)
  continuous          Boolean     @default(false)
  originalEnrolmentId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  rowVersion          Int         @default(1)
  section             Section     @relation(fields: [sectionId], references: [id])
  student             Student     @relation(fields: [studentId], references: [id])
  gradeItems          GradeItem[]

  @@unique([sectionId, studentId, attemptNumber])
  @@index([institutionId])
  @@index([studentId, status])
  @@index([originalEnrolmentId])
}

model Assignment {
  id              String       @id @default(uuid())
  institutionId   String
  sectionId       String
  title           String
  maxScore        Float
  weightPercent   Float
  dueAt           DateTime?
  rubricId        String?
  instructions    String?
  availableFrom   DateTime?
  cutoffAt        DateTime?
  maxFiles        Int?
  maxFileBytes    Int?
  acceptedTypes   String?
  fileSubmissions Boolean      @default(true)
  onlineText      Boolean      @default(false)
  hidden          Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  rowVersion      Int          @default(1)
  section         Section      @relation(fields: [sectionId], references: [id])
  rubric          Rubric?      @relation(fields: [rubricId], references: [id])
  gradeItems      GradeItem[]
  submissions     Submission[]
  studySessions   StudySession[]

  @@index([institutionId])
  @@index([rubricId])
}

model Submission {
  id            String       @id @default(uuid())
  institutionId String
  assignmentId  String
  studentId     String
  submittedAt   DateTime?
  status        String       @default("draft")
  textBody      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  rowVersion    Int          @default(1)
  assignment    Assignment   @relation(fields: [assignmentId], references: [id])
  student       Student      @relation(fields: [studentId], references: [id])
  files         FileObject[]

  @@unique([assignmentId, studentId])
  @@index([institutionId])
  @@index([studentId, status])
}

model FileObject {
  id             String     @id @default(uuid())
  institutionId  String
  submissionId   String
  path           String
  filename       String
  mimeType       String
  sizeBytes      Int
  classification String     @default("confidential")
  version        Int
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  rowVersion     Int        @default(1)
  submission     Submission @relation(fields: [submissionId], references: [id])

  @@unique([submissionId, version])
  @@index([institutionId])
  @@index([submissionId, archivedAt])
}

model ClassSession {
  id                 String             @id @default(uuid())
  institutionId      String
  sectionId          String
  title              String
  startsAt           DateTime
  endsAt             DateTime?
  location           String?
  joinUrl            String?
  deliveryMode       String             @default("in_person")
  sessionKind        String             @default("lecture")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  rowVersion         Int                @default(1)
  section            Section            @relation(fields: [sectionId], references: [id])
  attendanceRecords  AttendanceRecord[]
  labNotebookEntries LabNotebookEntry[]

  @@index([institutionId, startsAt])
  @@index([sectionId, startsAt])
  @@index([institutionId, sessionKind])
}

model GradeItem {
  id            String     @id @default(uuid())
  institutionId String
  assignmentId  String
  studentId     String
  enrolmentId   String
  score         Float?
  maxScore      Float
  letter        String?
  feedback      String?
  status        String     @default("draft")
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  rowVersion    Int        @default(1)
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  student       Student    @relation(fields: [studentId], references: [id])
  enrolment     Enrolment  @relation(fields: [enrolmentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([institutionId])
  @@index([studentId, status])
}

model ApprovalRequest {
  id                        String   @id @default(uuid())
  institutionId             String
  type                      String
  subjectRef                String
  proposedDiffJson          String
  requestedBy               String
  requiredApproverRolesJson String
  requiredCount             Int
  status                    String   @default("pending")
  decisionsJson             String   @default("[]")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  rowVersion                Int      @default(1)

  @@index([institutionId, status])
}

model AuditEvent {
  id            String   @id @default(uuid())
  institutionId String
  actorId       String
  eventName     String
  purpose       String
  beforeJson    String?
  afterJson     String?
  source        String
  correlationId String
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)

  @@index([institutionId])
  @@index([correlationId])
}

model EventOutbox {
  id            String   @id @default(uuid())
  institutionId String
  eventName     String
  payloadJson   String
  status        String   @default("pending")
  attempts      Int      @default(0)
  availableAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)

  @@index([status, availableAt])
  @@index([institutionId])
}

model Notification {
  id                 String    @id @default(uuid())
  institutionId      String
  recipientAccountId String
  channel            String
  title              String
  body               String
  readAt             DateTime?
  templateKey        String?
  dedupeKey          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  rowVersion         Int       @default(1)
  recipient          Account   @relation(fields: [recipientAccountId], references: [id])

  @@index([institutionId])
  @@index([recipientAccountId])
  @@unique([institutionId, recipientAccountId, dedupeKey])
}

model MessageThread {
  id                        String                @id @default(uuid())
  institutionId             String
  subject                   String
  participantAccountIdsJson String
  /// standard | individuals | class | workshop | mail_merge | groups
  messageType               String                @default("standard")
  ccAccountIdsJson          String                @default("[]")
  bccAccountIdsJson         String                @default("[]")
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  rowVersion                Int                   @default(1)
  messages                  Message[]
  placements                MailThreadPlacement[]

  @@index([institutionId])
}

model Message {
  id                 String        @id @default(uuid())
  institutionId      String
  threadId           String
  senderAccountId    String
  body               String
  relatedGradeItemId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  rowVersion         Int           @default(1)
  thread             MessageThread @relation(fields: [threadId], references: [id])
  attachments        MessageAttachment[]

  @@index([institutionId])
}

model MessageAttachment {
  id            String   @id @default(uuid())
  institutionId String
  messageId     String
  name          String
  mime          String
  sizeBytes     Int
  contentBase64 String   @db.Text
  createdAt     DateTime @default(now())
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([institutionId, messageId])
}

model IdempotencyKey {
  id            String   @id @default(uuid())
  institutionId String
  key           String
  method        String
  path          String
  responseJson  String
  statusCode    Int
  createdAt     DateTime @default(now())

  @@unique([institutionId, key, method, path])
}

model AiInteraction {
  id                   String   @id @default(uuid())
  institutionId        String
  accountId            String
  role                 String
  question             String
  answer               String
  sourcesJson          String
  suggestedActionsJson String   @default("[]")
  tier                 String   @default("read_only")
  provider             String   @default("campus_grounding_v1")
  capability           String   @default("campus_coach")
  latencyMs            Int      @default(0)
  estimatedTokens      Int      @default(0)
  resultStatus         String   @default("completed")
  status               String   @default("completed")
  feedback             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  rowVersion           Int      @default(1)
  account              Account  @relation(fields: [accountId], references: [id])

  @@index([institutionId, accountId, createdAt])
  @@index([institutionId, role, createdAt])
  @@index([institutionId, capability, createdAt])
}

/**
 * Live portal rows for screens without a dedicated domain table yet. Always seeded — never client-hardcoded.
 */
model PortalRecord {
  id                String   @id @default(uuid())
  institutionId     String
  screenPath        String
  role              String
  primaryText       String
  secondaryText     String?
  metaText          String?
  href              String?
  sortOrder         Int      @default(0)
  audienceAccountId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  rowVersion        Int      @default(1)

  @@index([institutionId, screenPath])
  @@index([institutionId, role])
}

/**
