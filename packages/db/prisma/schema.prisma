  earnedAt      DateTime?
  status        String    @default("available")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)
  student       Student   @relation(fields: [studentId], references: [id])

  @@unique([studentId, code])
  @@index([institutionId, studentId, status])
}

model CredentialRecord {
  id            String    @id @default(uuid())
  institutionId String
  studentId     String
  title         String
  status        String    @default("pending")
  detail        String?
  earnedAt      DateTime?
  sourceKey     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)
  student       Student   @relation(fields: [studentId], references: [id])

  @@unique([studentId, sourceKey])
  @@index([institutionId, studentId, status])
}

model AcademicBlock {
  id            String    @id @default(uuid())
  institutionId String
  code          String
  name          String
  startsOn      String
  endsOn        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)
  sections      Section[]

  @@unique([institutionId, code])
  @@index([institutionId, startsOn])
}

model CourseDayBlock {
  id            String         @id @default(uuid())
  institutionId String
  sectionId     String
  label         String
  title         String
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  rowVersion    Int            @default(1)
  section       Section        @relation(fields: [sectionId], references: [id])
  lessons       CourseLesson[]

  @@index([institutionId, sectionId, sortOrder])
}

model CourseLesson {
  id            String         @id @default(uuid())
  institutionId String
  dayBlockId    String
  title         String
  body          String         @default("")
  resourceHref  String?
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  rowVersion    Int            @default(1)
  dayBlock      CourseDayBlock @relation(fields: [dayBlockId], references: [id])

  @@index([institutionId, dayBlockId, sortOrder])
}

model CourseFolder {
  id            String             @id @default(uuid())
  institutionId String
  sectionId     String
  name          String
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  rowVersion    Int                @default(1)
  section       Section            @relation(fields: [sectionId], references: [id])
  items         CourseFolderItem[]

  @@index([institutionId, sectionId, sortOrder])
}

model CourseFolderItem {
  id            String       @id @default(uuid())
  institutionId String
  folderId      String
  title         String
  kind          String       @default("file")
  href          String?
  sizeLabel     String?
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  rowVersion    Int          @default(1)
  folder        CourseFolder @relation(fields: [folderId], references: [id])

  @@index([institutionId, folderId, sortOrder])
}

model SyllabusTopic {
  id            String   @id @default(uuid())
  institutionId String
  sectionId     String
  title         String
  level         Int      @default(1)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  section       Section  @relation(fields: [sectionId], references: [id])

  @@index([institutionId, sectionId, sortOrder])
}

model MailFolder {
  id            String                @id @default(uuid())
  institutionId String
  accountId     String
  name          String
  kind          String                @default("custom")
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  rowVersion    Int                   @default(1)
  account       Account               @relation(fields: [accountId], references: [id])
  placements    MailThreadPlacement[]

  @@unique([accountId, kind, name])
  @@index([institutionId, accountId, sortOrder])
}

model MailThreadPlacement {
  id            String        @id @default(uuid())
  institutionId String
  accountId     String
  threadId      String
  folderId      String
  readAt        DateTime?
  flagged       Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  rowVersion    Int           @default(1)
  account       Account       @relation(fields: [accountId], references: [id])
  thread        MessageThread @relation(fields: [threadId], references: [id])
  folder        MailFolder    @relation(fields: [folderId], references: [id])

  @@unique([accountId, threadId])
  @@index([institutionId, folderId])
}

model MailboxSettings {
  id                   String   @id @default(uuid())
  institutionId        String
  accountId            String   @unique
  forwardingEnabled    Boolean  @default(false)
  forwardingAddress    String?
  smsForwardingEnabled Boolean  @default(false)
  signature            String?
  popupNotifications   Boolean  @default(true)
  notificationSound    Boolean  @default(false)
  autoResponderEnabled Boolean  @default(false)
  autoResponderBody    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  rowVersion           Int      @default(1)
  account              Account  @relation(fields: [accountId], references: [id])

  @@index([institutionId])
}

model MailDistributionList {
  id                   String   @id @default(uuid())
  institutionId        String
  accountId            String
  name                 String
  memberAccountIdsJson String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  rowVersion           Int      @default(1)
  account              Account  @relation(fields: [accountId], references: [id])

  @@index([institutionId, accountId])
}

model CourseResourceCategory {
  id            String           @id @default(uuid())
  institutionId String
  name          String
  language      String           @default("English")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  rowVersion    Int              @default(1)
  resources     CourseResource[]

  @@index([institutionId])
}

model CourseResource {
  id              String                  @id @default(uuid())
  institutionId   String
  categoryId      String?
  courseId        String?
  name            String
  language        String                  @default("English")
  allowQuantities Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  rowVersion      Int                     @default(1)
  category        CourseResourceCategory? @relation(fields: [categoryId], references: [id])
  course          Course?                 @relation(fields: [courseId], references: [id])

  @@index([institutionId])
  @@index([categoryId])
  @@index([courseId])
}

model BadgeDefinition {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  description   String   @default("")
  badgeText     String   @default("")
  imageUrl      String?
  approvalMode  String   @default("Instant / Automated")
  badgeType     String   @default("Designation / Academic Performance")
  programsRule  String   @default("All Programs")
  coursesRule   String   @default("Any")
  termsRule     String   @default("Any")
  averageType   String   @default("None")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)

  @@index([institutionId])
}

/// Campus compliance: attendance miss escalation, teacher SLAs, explanation locks.
model ComplianceCase {
  id            String    @id @default(uuid())
  institutionId String
  subjectType   String
  subjectRef    String
  caseKind      String
  severity      String    @default("warning")
  status        String    @default("open")
  title         String
  detail        String    @default("")
  missCount     Int       @default(0)
  explanation   String?
  resolvedAt    DateTime?
  resolvedById  String?
  metaJson      String    @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)

  @@index([institutionId, status])
  @@index([institutionId, caseKind, status])
  @@index([subjectType, subjectRef])
}

/// Join telemetry for class sessions (mobile vs desktop). Report only — never blocks.
model SessionJoinEvent {
  id             String   @id @default(uuid())
  institutionId  String
  classSessionId String
  studentId      String?
  accountId      String?
  clientKind     String   @default("unknown")
  userAgent      String   @default("")
  joinedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  rowVersion     Int      @default(1)

  @@index([institutionId, joinedAt])
  @@index([classSessionId, joinedAt])
  @@index([studentId, joinedAt])
}

/// Record saved from a Heritage master screen (screenId = registry id such as F14). `contextKey` scopes
/// records to a parent (e.g. `student:<id>`); `singletonKey` marks settings screens holding one record.
model HeritageRecord {
  id            String    @id @default(uuid())
  institutionId String
  screenId      String
  contextKey    String    @default("")
  singletonKey  String?
  status        String    @default("active")
  dataJson      String    @default("{}")
  createdById   String
  updatedById   String
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)

  @@unique([institutionId, screenId, contextKey, singletonKey])
  @@index([institutionId, screenId, contextKey])
}

model HeritageAuditEntry {
  id            String   @id @default(uuid())
  institutionId String
  screenId      String
  contextKey    String   @default("")
  recordId      String?
  action        String
  actorId       String
  actorName     String   @default("")
  beforeJson    String?
  afterJson     String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([institutionId, screenId, createdAt])
  @@index([institutionId, contextKey, createdAt])
  @@index([recordId])
}
