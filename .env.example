POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_PASSWORD=replace-with-a-different-long-random-password
CONFIG_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
DATABASE_URL="postgresql://heritage:replace-with-url-encoded-password@127.0.0.1:5432/heritage"
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
OBJECT_STORAGE_ROOT=/app/var/uploads
# Production: use an off-host-synchronised mount. Backups include PostgreSQL,
# object files and SHA-256 manifests; 14 daily restore points are retained.
BACKUP_ROOT=./backups/runtime
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
NEXT_PUBLIC_API_URL=http://localhost:4000
# Enable on exactly one API instance, or move these jobs to a dedicated scheduler.
ENABLE_API_SCHEDULERS=false
SESSION_SECRET=dev-session-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me
PORTAL_COOKIE_SECRET=dev-portal-cookie-secret-change-me-32

# Mail (Humanitix) — set to "off" to disable
HUMANITIX_SEND_MAIL_URL=https://onlinemandiapp.com/Humanitix/api/send_mail

# Ask Heritage AI (Humanitix first; optional OpenAI/Anthropic fallbacks)
HUMANITIX_ASK_URL=https://onlinemandiapp.com/Humanitix/api/ask
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# XTTS is separately licensed; enable only after your organization accepts the model terms.
XTTS_LICENSE_ACCEPTED=0
XTTS_URL=

# Expose reset token in forgot-password JSON (for smoke tests)
EXPOSE_RESET_TOKEN=1
