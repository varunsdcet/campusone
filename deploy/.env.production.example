# Copy to /opt/myheritage/.env.production and adjust values.
# Used by docker compose --env-file and by api/workers containers.

POSTGRES_USER=heritage
POSTGRES_PASSWORD=HeritagePg!2026
POSTGRES_DB=heritage

# Prisma / app DB URL (host `postgres` is the compose service name)
DATABASE_URL=postgresql://heritage:HeritagePg!2026@postgres:5432/heritage

API_PORT=4000
WEB_ORIGIN=https://myvccbc.com,http://localhost:3000
# Browser calls same-origin /__api; Next proxies to the api container.
NEXT_PUBLIC_API_URL=/__api
API_PROXY_TARGET=http://api:4000

# Which proxies the API trusts for the client IP (public rate limits key on it).
# Default suits nginx -> web -> api on private networks. If a CDN or another public proxy
# (Cloudflare, a load balancer) sits in front, set the number of hops or its addresses,
# e.g. TRUST_PROXY=3, otherwise every visitor shares one rate-limit bucket. "false" trusts none.
# TRUST_PROXY=loopback, linklocal, uniquelocal

SESSION_SECRET=change-me-session-secret-prod
JWT_SECRET=change-me-jwt-secret-prod

# Mail + Ask Heritage (Humanitix)
HUMANITIX_SEND_MAIL_URL=https://onlinemandiapp.com/Humanitix/api/send_mail
HUMANITIX_ASK_URL=https://onlinemandiapp.com/Humanitix/api/ask
EXPOSE_RESET_TOKEN=1

# AI provider tried first for Ask Heritage, AI drafts and the self-paced coach (Humanitix/Anthropic/OpenAI stay as fallbacks).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# AI Draft avatar narration via HeyGen text-to-speech (word timestamps drive lip-sync).
# HEYGEN_VOICE_ID voices the female avatar; HEYGEN_MALE_VOICE_ID (optional) the male one. Unset voices use Google TTS below.
HEYGEN_API_KEY=
HEYGEN_VOICE_ID=03818d39fc454fd4a541186165d1d3fa
HEYGEN_MALE_VOICE_ID=

# /akshatsir lecture reader: XTTS-v2 voice-clone servers (xtts, xtts2 in docker-compose.prod.yml), comma-separated.
XTTS_URL=http://xtts:8020,http://xtts2:8020

# Optional: Google Cloud Text-to-Speech for AI Draft avatar (Neural2 + word lip-sync).
# If unset, AI Draft falls back to Google Translate TTS voice with estimated lip-sync marks.
GOOGLE_TTS_API_KEY=

# Self-paced (/selfpaced) — Stripe hosted Checkout (Test mode)
# Get keys: https://dashboard.stripe.com/test/apikeys
# Leave SELFPACED_STRIPE_DEMO unset/0 so Enroll opens checkout.stripe.com
SELFPACED_STRIPE_DEMO=0
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Live classes — BigBlueButton server (`bbb-conf --secret` on the BBB host prints both values).
# Required in production: if unset, online classes fall back to public Jitsi Meet rooms.
# (Outside production the API uses Blindside's public BBB test server when these are blank; BBB_URL=off disables BBB.)
BBB_URL=
BBB_SECRET=
# sha1 (default) | sha256 | sha384 | sha512 — must be enabled in the server's supportedChecksumAlgorithms.
BBB_CHECKSUM_ALGORITHM=sha1
# Public web address; BigBlueButton sends users back here when they leave a class.
WEB_PUBLIC_URL=https://myvccbc.com

NODE_ENV=production
